#version 330 core
out vec4 FragColor;
in vec3 Normal;
in vec2 aTexCoord;
in vec3 FragPos;

uniform sampler2D texture;
uniform vec3 lightDir;
uniform vec3 pointBlueLight;
uniform vec3 viewPos;
uniform vec3 Ld;
uniform vec3 La;
uniform vec3 Ls;
uniform vec3 md;
uniform vec3 ma;
uniform vec3 ms;

float rho = 32.0;

void main() 
{
    vec3 texColor = texture(texture, aTexCoord).rgb;

    vec3 norm = normalize(Normal);
    vec3 lightVector = normalize(pointBlueLight - FragPos);

    float diff = max(dot(lightDir, norm), 0.0);
    vec3 Kd = Ld * md;
    vec3 Cd = diff * Kd;

    vec3 Ca = La * ma;

    vec3 viewDir = normalize(viewPos - FragPos);
    vec3 reflectDir = reflect(-lightVector, norm);
    float Ks = pow(max(dot(viewDir,reflectDir),0.0), rho);
    vec3 Cs = Ks * Ls * ms;

    vec3 LitColour = Ca + Cd + Cs;
    FragColor = vec4(texColor * LitColour, 1.0);
}